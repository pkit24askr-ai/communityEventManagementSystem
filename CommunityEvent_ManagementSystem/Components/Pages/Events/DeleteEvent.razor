@page "/events/delete/{Id:int}"
@rendermode InteractiveServer

@using CommunityEvent_ManagementSystem.Data.Models
@using CommunityEvent_ManagementSystem.Interfaces

@inject IEventService EventService
@inject NavigationManager Navigation

<PageTitle>Delete Event</PageTitle>

<div class="container mt-4">

    <h2>Delete Event</h2>

    @if (eventItem == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="alert alert-danger">
            Are you sure you want to delete this event?
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <h3>@eventItem.EventName</h3>
                <p>@eventItem.Description</p>

                <p><b>Date:</b> @eventItem.EventDate.ToShortDateString()</p>
                <p><b>Time:</b> @eventItem.StartTime.ToString(@"hh\:mm") - @eventItem.EndTime.ToString(@"hh\:mm")</p>
                <p><b>Capacity:</b> @eventItem.Capacity</p>

                <p>
                    <b>Venue:</b>
                    @string.Join(", ", eventItem.EventVenues.Select(v => v.Venue!.VenueName))
                </p>

                <p>
                    <b>Activity:</b>
                    @string.Join(", ", eventItem.EventActivities.Select(a => a.Activity!.ActivityName))
                </p>

                <button class="btn btn-danger" @onclick="Delete">
                    Confirm Delete
                </button>

                <a href="/events" class="btn btn-secondary ms-2">
                    Cancel
                </a>

            </div>
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private CommunityEvent? eventItem;

    protected override async Task OnInitializedAsync()
    {
        eventItem = await EventService.GetByIdAsync(Id);
    }

    private async Task Delete()
    {
        await EventService.DeleteAsync(Id);
        Navigation.NavigateTo("/events");
    }
}