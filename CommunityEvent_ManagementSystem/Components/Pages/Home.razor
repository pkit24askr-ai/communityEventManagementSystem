@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">

    <div class="p-5 rounded-4 text-white shadow"
         style="background: linear-gradient(135deg,#0d6efd,#6610f2);">

        <h1 class="fw-bold">Community Event Management System</h1>

        <p class="lead mt-3">
            Browse upcoming community events, register for events, and manage event participation easily.
        </p>

        <div class="mt-4">
            <a href="/upcoming-events" class="btn btn-light btn-lg me-2">
                View Upcoming Events
            </a>

            <a href="/admin" class="btn btn-outline-light btn-lg">
                Admin Dashboard
            </a>
        </div>

    </div>

    <div class="row mt-5 g-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4>Events</h4>
                    <p>View all upcoming community events and filter them by date, venue, or activity.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4>Registrations</h4>
                    <p>Users can register for events and view their registration details.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h4>Admin Management</h4>
                    <p>Administrators can manage events, venues, activities, participants and registrations.</p>
                </div>
            </div>
        </div>

    </div>

</div>